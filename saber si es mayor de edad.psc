Algoritmo notafinal
	definir añoactual,añodenacimiento Como real
	escribir "Digite Año actual "
	leer añoactual
	escribir "Digite su Año de nacimiento "
	leer añodenacimiento
	Definir Edad Como Real
	Edad = (añoactual-añodenacimiento)
	Si Edad >= 18 Entonces
		escribir "su edad es"," ",Edad," años"
		escribir "Usted es mayor de edad"
	SiNo
		Si Promedio < 18  Entonces
			escribir "su edad es"," ",Edad " años"
			escribir "Usted es menor de edad"
		Fin Si
	Fin Si
FinAlgoritmo

